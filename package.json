{
  "name": "vihko",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && vue-tsc --noEmit && vite build",
    "build:wasm": "cd engine && GOOS=js GOARCH=wasm go build -o ../public/engine.wasm . && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../public/",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:go": "cd engine && go test ./...",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm cap:sync && cap open android",
    "cap:ios": "pnpm cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "^8.0.3",
    "three": "^0.187.0",
    "vue": "^3.5.13",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
